              <rect class="flow-box" x="420" y="28" width="90" height="36" rx="6"/>
              <text class="flow-label" x="465" y="50" text-anchor="middle">Threshold</text>
              <path class="flow-line" d="M510 46 H590" />
              <path class="flow-current a3" d="M510 46 H590" />
              <circle cx="600" cy="46" r="10" fill="none" stroke="#FF8F6B" stroke-width="1.4"/>
              <text class="flow-label" x="600" y="82" text-anchor="middle" style="fill:#8790A3; font-size:10.5px;">ALERT</text>
