<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mahesh Dandhare — Electrical Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0B0E17;
    --surface: #141924;
    --surface-2: #1B2230;
    --line: #232B3A;
    --line-soft: #1A2130;
    --indigo: #8B5CF6;
    --indigo-bright: #A78BFA;
    --coral: #FB7185;
    --coral-soft: rgba(251,113,133,0.12);
    --cyan: #22D3EE;
    --emerald: #34D399;
    --amber: #FBBF24;
    --text: #EDEFF5;
    --muted: #8790A3;
    --muted-2: #5B6579;
    --mono: 'JetBrains Mono', monospace;
    --display: 'Space Grotesk', sans-serif;
    --body: 'Inter', sans-serif;
    --ease: cubic-bezier(.16,.8,.24,1);
  }

  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    line-height: 1.65;
    overflow-x: hidden;
  }

  ::selection{ background: var(--indigo); color: #0B0E14; }

  a{ color:inherit; text-decoration:none; }

  .container{ max-width: 1040px; margin:0 auto; padding: 0 32px; }

  /* ================= preloader ================= */
  #preloader{
    position: fixed; inset:0; z-index:200;
    background: var(--bg);
    display:flex; align-items:center; justify-content:center;
    transition: opacity .6s var(--ease), visibility .6s var(--ease);
  }
  #preloader.done{ opacity:0; visibility:hidden; pointer-events:none; }
  .pre-mark{
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    display:flex; flex-direction:column; align-items:center; gap:18px;
  }
  .pre-bar{
    width: 220px; height:2px; background: var(--line);
    position:relative; overflow:hidden; border-radius:2px;
  }
  .pre-bar::after{
    content:'';
    position:absolute; top:0; left:0; height:100%; width:40%;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--indigo), var(--coral), transparent);
    animation: preload 1.1s ease-in-out infinite;
  }
  @keyframes preload{
    0%{ transform: translateX(-100%); }
    100%{ transform: translateX(350%); }
  }

  /* ================= background grid + glow ================= */
  .bg-grid{
    position: fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 40%, transparent 100%);
  }
  .glow-orb{
    position: fixed; z-index:0; pointer-events:none;
    width: 640px; height: 640px; border-radius: 50%;
    filter: blur(130px); opacity: .18;
    animation: orbdrift 16s ease-in-out infinite alternate;
  }
  .glow-orb.one{ top:-220px; left:-160px; background: var(--coral); }
  .glow-orb.two{ top: 22%; right:-260px; background: var(--indigo); opacity:.14; animation-delay: -5s; }
  .glow-orb.three{ bottom:-260px; left: 20%; width:520px; height:520px; background: var(--cyan); opacity:.11; animation-delay: -10s; }
  @keyframes orbdrift{
    0%{ transform: translate(0,0) scale(1); }
    100%{ transform: translate(30px,-40px) scale(1.08); }
  }

  main, header, footer{ position: relative; z-index: 1; }

  /* ================= nav ================= */
  header{
    position: sticky; top:0; z-index:20;
    padding: 22px 0;
    transition: padding .35s var(--ease), background .35s var(--ease), border-color .35s var(--ease);
    border-bottom: 1px solid transparent;
  }
  header.scrolled{
    padding: 14px 0;
    background: rgba(6,10,16,0.82);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  nav{ display:flex; justify-content:space-between; align-items:center; }
  .logo{ font-family: var(--mono); font-size: 14px; color: var(--indigo-bright); letter-spacing: .5px; display:flex; align-items:center; gap:8px; }
  .logo .led{ width:6px; height:6px; border-radius:50%; background: var(--emerald); box-shadow: 0 0 8px var(--emerald); animation: pulse-led 2s ease-in-out infinite; }
  @keyframes pulse-led{ 0%,100%{opacity:1;} 50%{opacity:.3;} }

  .navlinks{ display:flex; gap: 34px; font-family: var(--mono); font-size: 12.5px; }
  .navlinks a{ position:relative; color: var(--muted); transition: color .25s ease; padding: 4px 0; }
  .navlinks a::after{
    content:''; position:absolute; left:0; bottom:-2px; width:0; height:1px;
    background: linear-gradient(90deg, var(--cyan), var(--coral)); transition: width .3s var(--ease);
  }
  .navlinks a:hover, .navlinks a.active{ color: var(--text); }
  .navlinks a:hover::after, .navlinks a.active::after{ width:100%; }
  @media (max-width:640px){ .navlinks{ display:none; } }

  /* ================= hero ================= */
  .hero{
    min-height: 92vh;
    display:flex; flex-direction:column; justify-content:center;
    padding: 60px 0 80px;
    position: relative;
  }
  .hero-svg-wrap{
    position:absolute; top:50%; right:-6%; transform:translateY(-50%);
    width: 480px; height: 480px; opacity: .9; pointer-events:none;
  }
  @media (max-width:900px){ .hero-svg-wrap{ display:none; } }
  .circuit-path{
    fill:none; stroke: var(--line); stroke-width: 1.4;
  }
  .circuit-path.draw{
    stroke: var(--coral);
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    animation: draw 2.6s var(--ease) forwards;
  }
  .circuit-path.draw.amber{ stroke: var(--cyan); }
  @keyframes draw{ to{ stroke-dashoffset: 0; } }
  .circuit-node{ fill: var(--surface); stroke: var(--muted-2); stroke-width: 1.4; }
  .circuit-node.lit{ stroke: var(--coral); animation: nodepulse 2.4s ease-in-out infinite; }
  .circuit-node.lit2{ stroke: var(--cyan); animation: nodepulse 2.4s ease-in-out infinite; animation-delay: 1.2s; }
  @keyframes nodepulse{ 0%,100%{ opacity:.5 } 50%{ opacity:1 } }

  .eyebrow{
    font-family: var(--mono); font-size: 12px; color: var(--cyan);
    text-transform: uppercase; letter-spacing: 2.5px;
    display:flex; align-items:center; gap:10px; margin-bottom: 22px;
    opacity:0; transform: translateY(10px);
    animation: fadeup .7s var(--ease) forwards; animation-delay: .15s;
  }
  .eyebrow::before{ content:''; width:22px; height:1px; background: var(--cyan); }

  @keyframes fadeup{ to{ opacity:1; transform:translateY(0); } }

  .hero h1{
    font-family: var(--display); font-weight: 700;
    font-size: clamp(2.6rem, 5.6vw, 4.4rem);
    line-height: 1.06; letter-spacing: -1.5px;
    max-width: 780px;
    opacity:0; transform: translateY(16px);
    animation: fadeup .8s var(--ease) forwards; animation-delay: .3s;
  }
  .hero h1 .accent{
    background: linear-gradient(100deg, var(--cyan), var(--indigo-bright), var(--coral), var(--amber));
    background-size: 300% auto;
    -webkit-background-clip: text; background-clip:text; color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }
  @keyframes shimmer{
    0%{ background-position: 0% 50%; }
    50%{ background-position: 100% 50%; }
    100%{ background-position: 0% 50%; }
  }

  .role-line{
    font-family: var(--mono); font-size: 15px; color: var(--muted);
    margin-top: 22px; min-height: 22px;
    opacity:0; animation: fadeup .8s var(--ease) forwards; animation-delay: .5s;
  }
  .role-line .cursor{ display:inline-block; width:8px; background: var(--amber); margin-left:2px; animation: blink .9s steps(1) infinite; }
  @keyframes blink{ 50%{ opacity:0; } }

  .hero p.tagline{
    font-size: 1.08rem; color: var(--muted); max-width: 540px; margin-top: 22px;
    opacity:0; transform: translateY(14px);
    animation: fadeup .8s var(--ease) forwards; animation-delay: .65s;
  }
  .hero p.tagline b{ color: var(--text); font-weight:600; }

  .cta-row{
    display:flex; gap:16px; flex-wrap:wrap; margin-top: 40px;
    opacity:0; transform: translateY(14px);
    animation: fadeup .8s var(--ease) forwards; animation-delay: .8s;
  }

  .btn{
    font-family: var(--mono); font-size: 13px; letter-spacing:.3px;
    padding: 14px 26px; border-radius: 4px; cursor:pointer;
    border: none; color: #0B0E17;
    background: linear-gradient(100deg, var(--cyan), var(--indigo-bright), var(--coral));
    background-size: 220% auto; background-position: 0% 50%;
    position: relative; overflow:hidden;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease), background-position .5s var(--ease);
  }
  .btn span{ position:relative; z-index:1; }
  .btn:hover{ transform: translateY(-2px); background-position: 100% 50%; box-shadow: 0 10px 34px -8px rgba(139,92,246,0.55); }
  .btn.ghost{ background: transparent; color: var(--muted); border: 1px solid var(--line); }
  .btn.ghost:hover{ color: var(--cyan); border-color: var(--cyan); box-shadow: 0 10px 30px -10px rgba(34,211,238,0.35); background:transparent; }

  .scroll-cue{
    position:absolute; bottom: 20px; left:32px;
    font-family: var(--mono); font-size: 10.5px; color: var(--muted-2);
    display:flex; align-items:center; gap:10px;
    opacity:0; animation: fadeup .8s var(--ease) forwards; animation-delay: 1.1s;
  }
  .scroll-cue .line{ width:1px; height:26px; background: var(--line); position:relative; overflow:hidden; }
  .scroll-cue .line::after{
    content:''; position:absolute; top:-100%; left:0; width:100%; height:100%;
    background: var(--coral); animation: scrolldrop 1.8s ease-in-out infinite;
  }
  @keyframes scrolldrop{ 0%{top:-100%;} 60%{top:100%;} 100%{top:100%;} }

  /* ================= sections ================= */
  section{ padding: 110px 0; border-top: 1px solid var(--line-soft); }
  .section-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom: 52px; flex-wrap:wrap; gap:14px; }
  .section-title{ font-family: var(--display); font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight:600; letter-spacing:-.5px; }
  .section-index{ font-family: var(--mono); font-size: 12px; color: var(--muted-2); }

  .reveal{ opacity:0; transform: translateY(30px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
  .reveal.in{ opacity:1; transform: translateY(0); }
  .stagger .reveal:nth-child(1){ transition-delay: 0s; }
  .stagger .reveal:nth-child(2){ transition-delay: .08s; }
  .stagger .reveal:nth-child(3){ transition-delay: .16s; }
  .stagger .reveal:nth-child(4){ transition-delay: .24s; }

  /* ================= about ================= */
  .about-grid{ display:grid; grid-template-columns: 1.15fr .85fr; gap: 60px; align-items:start; }
  @media (max-width:760px){ .about-grid{ grid-template-columns:1fr; } }
  .about-grid p{ color: var(--muted); margin-bottom: 18px; font-size: 1rem; }
  .about-grid p b{ color: var(--text); font-weight:600; }

  .spec-card{
    background: var(--surface); border:1px solid var(--line); border-radius:10px;
    padding: 28px; font-family: var(--mono); font-size: 13px;
    position: relative; overflow:hidden;
  }
  .spec-card::before{
    content:'SPEC'; position:absolute; top:14px; right:16px;
    font-size:10px; color: var(--muted-2); letter-spacing:2px;
  }
  .spec-card .row{
    display:flex; justify-content:space-between; padding: 12px 0;
    border-bottom: 1px dashed var(--line); color: var(--muted);
  }
  .spec-card .row:last-child{ border-bottom:none; }
  .spec-card .row span:last-child{ color: var(--text); }
  .spec-card .row .live{ color: var(--coral); display:flex; align-items:center; gap:6px; }
  .spec-card .row .live::before{ content:''; width:6px; height:6px; border-radius:50%; background: var(--coral); box-shadow:0 0 8px var(--coral); animation: pulse-led 1.8s ease-in-out infinite; }

  /* ================= skills ================= */
  .skills-grid{ display:grid; grid-template-columns: repeat(auto-fit, minmax(230px,1fr)); gap: 20px; }
  .skill-card{
    background: var(--surface); border:1px solid var(--line); border-radius:10px;
    padding: 26px; position:relative; overflow:hidden;
    transition: transform .4s var(--ease), border-color .4s var(--ease), background .4s var(--ease);
    --acc: var(--coral);
  }
  .skill-card:nth-of-type(5n+1){ --acc: var(--coral); }
  .skill-card:nth-of-type(5n+2){ --acc: var(--cyan); }
  .skill-card:nth-of-type(5n+3){ --acc: var(--indigo-bright); }
  .skill-card:nth-of-type(5n+4){ --acc: var(--emerald); }
  .skill-card:nth-of-type(5n+5){ --acc: var(--amber); }
  .skill-card::after{
    content:''; position:absolute; top:0; left:0; right:0; height:2px;
    background: var(--acc); transform: scaleX(0); transform-origin:left;
    transition: transform .4s var(--ease);
  }
  .skill-card:hover::after{ transform: scaleX(1); }
  .skill-card::before{
    content:''; position:absolute; inset:0; opacity:0;
    background: radial-gradient(240px circle at var(--mx,50%) var(--my,50%), color-mix(in srgb, var(--acc) 18%, transparent), transparent 60%);
    transition: opacity .4s ease;
  }
  .skill-card:hover::before{ opacity:1; }
  .skill-card:hover{ transform: translateY(-6px); border-color: var(--acc); background: var(--surface-2); }
  .skill-num{ font-family: var(--mono); font-size:11px; color: var(--acc); opacity:.8; }
  .skill-card h3{ font-family: var(--display); font-size: 1.1rem; margin: 12px 0 10px; position:relative; }
  .skill-card p{ font-size: 13.5px; color: var(--muted); position:relative; }
  .skill-bar{ height:2px; background: var(--line); border-radius:2px; margin-top:18px; overflow:hidden; }
  .skill-bar-fill{ height:100%; width:0%; background: var(--acc); box-shadow: 0 0 8px var(--acc); transition: width 1.4s var(--ease); }
  .skill-card.in .skill-bar-fill{ width: var(--fill); }

  /* ================= projects / timeline ================= */
  .timeline{ position:relative; padding-left: 36px; }
  .timeline::before{
    content:''; position:absolute; left:6px; top:6px; bottom:6px; width:1px;
    background: var(--line);
  }
  .timeline::after{
    content:''; position:absolute; left:6px; top:6px; width:1px; height:0;
    background: linear-gradient(var(--coral), var(--indigo));
    transition: height 1.4s var(--ease);
  }
  .timeline.in::after{ height: calc(100% - 12px); }

  .tl-item{ position:relative; margin-bottom: 44px; }
  .tl-item:last-child{ margin-bottom:0; }
  .tl-item:nth-of-type(5n+1){ --acc: var(--coral); }
  .tl-item:nth-of-type(5n+2){ --acc: var(--cyan); }
  .tl-item:nth-of-type(5n+3){ --acc: var(--emerald); }
  .tl-item:nth-of-type(5n+4){ --acc: var(--indigo-bright); }
  .tl-item:nth-of-type(5n+5){ --acc: var(--amber); }
  .tl-dot{
    position:absolute; left:-36px; top:6px; width:13px; height:13px; border-radius:50%;
    background: var(--surface); border: 2px solid var(--line); z-index:2;
    transition: border-color .4s ease, box-shadow .4s ease;
  }
  .tl-item.in .tl-dot{ border-color: var(--acc, var(--coral)); box-shadow: 0 0 12px var(--acc, var(--coral)); }

  .project-card{
    background: var(--surface); border:1px solid var(--line); border-radius: 12px;
    padding: 36px; position:relative; overflow:hidden;
  }
  .project-card.featured{ border-color: rgba(251,113,133,0.4); }
  .project-card .status{
    position:absolute; top:26px; right:28px; font-family: var(--mono); font-size:11px;
    color: var(--coral); border:1px solid rgba(251,113,133,.4); border-radius:20px; padding:5px 13px;
    display:flex; align-items:center; gap:7px;
  }
  .project-card:not(.featured) .status{ color: var(--emerald); border-color: rgba(52,211,153,.4); }
  .project-card .status .dot{ width:6px; height:6px; border-radius:50%; background: currentColor; box-shadow:0 0 8px currentColor; animation: pulse-led 1.8s ease-in-out infinite; }
  .project-card h3{ font-family: var(--display); font-size: 1.55rem; margin-bottom: 12px; max-width: 78%; }
  .project-card p.desc{ color: var(--muted); max-width: 580px; margin-bottom: 26px; }
  .stack-row{ display:flex; gap:10px; flex-wrap:wrap; margin-bottom: 30px; }
  .stack-tag{ font-family: var(--mono); font-size:11px; border:1px solid var(--line); padding:6px 13px; border-radius:20px; }
  .stack-tag:nth-of-type(5n+1){ color: var(--indigo-bright); }
  .stack-tag:nth-of-type(5n+2){ color: var(--cyan); }
  .stack-tag:nth-of-type(5n+3){ color: var(--coral); }
  .stack-tag:nth-of-type(5n+4){ color: var(--emerald); }
  .stack-tag:nth-of-type(5n+5){ color: var(--amber); }

  .flow-svg{ width:100%; height:auto; }
  .flow-box{ fill: var(--surface-2); stroke: var(--line); stroke-width:1.2; rx:6; }
  .flow-label{ font-family: var(--mono); font-size:12px; fill: var(--text); }
  .flow-line{ stroke: var(--line); stroke-width:1.4; fill:none; }
  .flow-current{ stroke-width:2; fill:none; stroke-linecap:round; stroke-dasharray: 6 300; }
  .flow-current.a1{ stroke: var(--cyan); filter: drop-shadow(0 0 4px var(--cyan)); animation: flowdash 2.4s linear infinite; }
  .flow-current.a2{ stroke: var(--coral); filter: drop-shadow(0 0 4px var(--coral)); animation: flowdash 2.4s linear infinite; animation-delay: .8s; }
  .flow-current.a3{ stroke: var(--amber); filter: drop-shadow(0 0 4px var(--amber)); animation: flowdash 2.4s linear infinite; animation-delay: 1.6s; }
  @keyframes flowdash{ from{ stroke-dashoffset: 0; } to{ stroke-dashoffset: -306; } }

  .hack-strip{
    display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap;
    background: var(--surface); border:1px solid var(--line);
    padding: 24px 30px; border-radius: 8px;
  }
  .hack-strip:nth-of-type(1), .tl-item:nth-of-type(3) .hack-strip{ border-left: 3px solid var(--emerald); }
  .tl-item:nth-of-type(4) .hack-strip{ border-left: 3px solid var(--indigo-bright); }
  .hack-strip .label{ font-family: var(--mono); font-size:11px; letter-spacing:1.5px; margin-bottom:6px; color: var(--cyan); }
  .hack-strip h4{ font-family: var(--display); font-size: 1.15rem; font-weight:600; }
  .hack-strip p{ color: var(--muted); font-size: 13.5px; margin-top:5px; max-width: 520px; }
  .hack-strip .badge{ font-family: var(--mono); font-size:11px; color: var(--amber); border:1px solid rgba(251,191,36,.4); padding:8px 16px; border-radius:20px; white-space:nowrap; }

  /* ================= contact ================= */
  .contact-wrap{ display:grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  @media (max-width:700px){ .contact-wrap{ grid-template-columns:1fr; } }
  .contact-card{
    background: var(--surface); border:1px solid var(--line); border-radius:10px;
    padding: 26px; display:flex; align-items:center; gap:18px; cursor:pointer;
    transition: border-color .3s ease, transform .3s var(--ease), background .3s ease;
    position: relative;
  }
  .contact-card:nth-of-type(1) .icon{ border-color: var(--cyan); color: var(--cyan); }
  .contact-card:nth-of-type(2) .icon{ border-color: var(--coral); color: var(--coral); }
  .contact-card:nth-of-type(1):hover{ border-color: var(--cyan); transform: translateY(-3px); background: var(--surface-2); }
  .contact-card:nth-of-type(2):hover{ border-color: var(--coral); transform: translateY(-3px); background: var(--surface-2); }
  .contact-card .icon{
    width:44px; height:44px; border-radius:50%; border:1px solid var(--indigo);
    display:flex; align-items:center; justify-content:center; color: var(--indigo-bright);
    flex-shrink:0; font-family: var(--mono); font-size:16px;
  }
  .contact-card .label{ font-family: var(--mono); font-size:11px; color: var(--muted); letter-spacing:1.5px; margin-bottom:5px; }
  .contact-card .value{ font-size: 14.5px; word-break: break-word; }
  .copy-hint{ position:absolute; right:20px; font-family: var(--mono); font-size:10.5px; color: var(--muted-2); opacity:0; transition: opacity .25s ease; }
  .contact-card:hover .copy-hint{ opacity:1; }
  .copy-hint.copied{ color: var(--coral); opacity:1; }

  footer{ padding: 46px 0 60px; border-top: 1px solid var(--line-soft); }
  footer .container{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; font-family: var(--mono); font-size:12px; color: var(--muted-2); }

  @media (prefers-reduced-motion: reduce){
    *{ animation: none !important; transition: none !important; }
  }
  a:focus-visible, button:focus-visible, .contact-card:focus-visible{ outline: 2px solid var(--coral); outline-offset: 3px; }
</style>
</head>
<body>

<div id="preloader">
  <div class="pre-mark">
    <span>INITIALIZING PORTFOLIO…</span>
    <div class="pre-bar"></div>
  </div>
</div>

<div class="bg-grid" aria-hidden="true"></div>
<div class="glow-orb one" aria-hidden="true"></div>
<div class="glow-orb two" aria-hidden="true"></div>
<div class="glow-orb three" aria-hidden="true"></div>

