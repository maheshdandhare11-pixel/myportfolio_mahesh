<footer>
  <div class="container">
    <span>© 2026 Mahesh Dandhare</span>
    <span>Built with Arduino, Python &amp; curiosity</span>
  </div>
</footer>

<script>
  // preloader
  window.addEventListener('load', ()=>{
    setTimeout(()=> document.getElementById('preloader').classList.add('done'), 500);
  });

  // header scroll state
  const header = document.getElementById('siteHeader');
  window.addEventListener('scroll', ()=>{
    header.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive:true });

  // active nav link on scroll
  const sections = ['about','skills','projects','contact'].map(id=>document.getElementById(id));
  const navLinks = document.querySelectorAll('.nl');
  const navObserver = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        navLinks.forEach(l=>l.classList.remove('active'));
        const match = document.querySelector('.nl[href="#'+entry.target.id+'"]');
        if(match) match.classList.add('active');
      }
    });
  }, { rootMargin: '-40% 0px -50% 0px' });
  sections.forEach(s=> s && navObserver.observe(s));

  // scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => io.observe(el));

  // skill bar fill trigger
  document.querySelectorAll('.skill-card').forEach(card=>{
    const obs = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target); }
      });
    }, { threshold:.3 });
    obs.observe(card);
  });

  // timeline growth
  document.querySelectorAll('.timeline').forEach(tl=>{
    const obs = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target); } });
    }, { threshold:.1 });
    obs.observe(tl);
  });
  document.querySelectorAll('.tl-item').forEach(item=>{
    const obs = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target); } });
    }, { threshold:.3 });
    obs.observe(item);
  });

  // skill card mouse-follow glow
  document.querySelectorAll('.skill-card').forEach(card=>{
    card.addEventListener('mousemove', (e)=>{
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      card.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });

  // typing role line
  const roles = ['Embedded Systems Builder', 'Sensor Integration Enthusiast', 'Arduino · Python · C/C++', 'BME & PPS Hackathon Participant'];
  const roleEl = document.getElementById('roleLine');
  let ri = 0, ci = 0, deleting = false;
  function typeLoop(){
    const word = roles[ri];
    if(!deleting){
      ci++;
      if(ci > word.length){ deleting = true; setTimeout(typeLoop, 1400); return; }
    } else {
      ci--;
      if(ci < 0){ deleting = false; ri = (ri+1) % roles.length; ci = 0; }
    }
    roleEl.innerHTML = '&gt; ' + word.slice(0, ci) + '<span class="cursor">&nbsp;</span>';
    setTimeout(typeLoop, deleting ? 35 : 65);
  }
  typeLoop();

  // copy to clipboard on contact cards
  document.querySelectorAll('.contact-card').forEach(card=>{
    const hint = card.querySelector('.copy-hint');
    function doCopy(){
      const val = card.getAttribute('data-copy');
      navigator.clipboard && navigator.clipboard.writeText(val).then(()=>{
        hint.textContent = 'copied ✓';
        hint.classList.add('copied');
        setTimeout(()=>{ hint.textContent = 'click to copy'; hint.classList.remove('copied'); }, 1600);
      });
    }
    card.addEventListener('click', doCopy);
    card.addEventListener('keypress', (e)=>{ if(e.key === 'Enter') doCopy(); });
  });
</script>

</body>
</html>
